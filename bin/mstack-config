#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${MSTACK_HOME:-${MSTACK_STATE_DIR:-$HOME/.mstack}}"
CONFIG_FILE="$STATE_DIR/config"

usage() {
  cat <<'EOF'
Usage: bin/mstack-config get <key>
       bin/mstack-config set <key> <value>
       bin/mstack-config list
       bin/mstack-config defaults
EOF
}

default_value() {
  case "$1" in
    auto_upgrade) echo "false" ;;
    update_check) echo "true" ;;
    team_mode) echo "false" ;;
    skill_prefix) echo "mstack" ;;
    messaging_eval_strictness) echo "standard" ;;
    *) echo "" ;;
  esac
}

validate_key() {
  case "$1" in
    *[!a-zA-Z0-9_]*|"")
      echo "Error: key must contain only alphanumeric characters and underscores" >&2
      exit 1
      ;;
  esac
}

case "${1:-}" in
  get)
    key="${2:-}"
    validate_key "$key"
    value="$(grep -E "^${key}=" "$CONFIG_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
    if [ -z "$value" ]; then
      value="$(default_value "$key")"
    fi
    printf '%s' "$value"
    ;;
  set)
    key="${2:-}"
    value="${3:-}"
    validate_key "$key"
    mkdir -p "$STATE_DIR"
    touch "$CONFIG_FILE"
    tmp="$(mktemp "${CONFIG_FILE}.XXXXXX")"
    grep -Ev "^${key}=" "$CONFIG_FILE" > "$tmp" || true
    printf '%s=%s\n' "$key" "$value" >> "$tmp"
    mv "$tmp" "$CONFIG_FILE"
    ;;
  list)
    if [ -f "$CONFIG_FILE" ]; then
      cat "$CONFIG_FILE"
    fi
    echo
    echo "# Active values"
    for key in auto_upgrade update_check team_mode skill_prefix messaging_eval_strictness; do
      value="$(grep -E "^${key}=" "$CONFIG_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
      source="set"
      if [ -z "$value" ]; then
        value="$(default_value "$key")"
        source="default"
      fi
      printf '%-28s %s (%s)\n' "$key" "$value" "$source"
    done
    ;;
  defaults)
    for key in auto_upgrade update_check team_mode skill_prefix messaging_eval_strictness; do
      printf '%-28s %s\n' "$key" "$(default_value "$key")"
    done
    ;;
  *)
    usage
    exit 1
    ;;
esac
