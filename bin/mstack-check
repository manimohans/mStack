#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
HOSTS_FILE="$ROOT/config/hosts.json"
SKILLS_FILE="$ROOT/config/skills.json"

fail() {
  echo "FAIL $*" >&2
  exit 1
}

ok() {
  echo "OK $*"
}

cd "$ROOT"

bash -n setup
for script in bin/mstack-check bin/mstack-claim-check bin/mstack-config bin/mstack-source-intake bin/mstack-team-init bin/mstack-uninstall bin/mstack-update-check bin/mstack-upgrade; do
  bash -n "$script"
done
python3 -m py_compile scripts/claim_check.py scripts/gen-skill-docs.py scripts/host_config.py scripts/messaging_eval.py scripts/skill-check.py scripts/source_intake.py
python3 scripts/claim_check.py --self-test >/dev/null
python3 scripts/source_intake.py --self-test >/dev/null
ok "script syntax"

python3 - "$HOSTS_FILE" "$SKILLS_FILE" ".codex-plugin/plugin.json" <<'PY'
import json
import sys
from pathlib import Path

for raw_path in sys.argv[1:]:
    path = Path(raw_path)
    try:
        json.loads(path.read_text())
    except Exception as exc:
        raise SystemExit(f"{path}: invalid JSON: {exc}")
PY
ok "json manifests"

python3 scripts/host_config.py validate >/dev/null
python3 scripts/skill-check.py
ok "skill docs"

tmp_root="$(mktemp -d "${TMPDIR:-/tmp}/mstack-check.XXXXXX")"
trap 'rm -rf "$tmp_root"' EXIT

MSTACK_HOME="$tmp_root/state" CODEX_HOME="$tmp_root/codex" ./setup --host codex --force --quiet
MSTACK_HOME="$tmp_root/state" CLAUDE_HOME="$tmp_root/claude" ./setup --host claude --force --quiet
MSTACK_HOME="$tmp_root/state" CODEX_HOME="$tmp_root/codex-noprefix" ./setup --host codex --no-prefix --force --quiet
MSTACK_HOME="$tmp_root/state" CODEX_HOME="$tmp_root/codex-copy" ./setup --host codex --copy --force --quiet

python3 scripts/host_config.py render --host codex --skill product-context --name mstack-product-context \
  | cmp -s - "$tmp_root/codex/skills/mstack-product-context/SKILL.md" \
  || fail "prefixed Codex install did not use host transform output"
python3 scripts/host_config.py render --host claude --skill angle-review --name mstack-angle-review \
  | cmp -s - "$tmp_root/claude/skills/mstack-angle-review/SKILL.md" \
  || fail "prefixed Claude install did not use host transform output"
grep -q '^name: mstack-product-context$' "$tmp_root/codex/skills/mstack-product-context/SKILL.md" \
  || fail "prefixed Codex install wrote wrong skill name"
grep -q '^name: mstack-angle-review$' "$tmp_root/claude/skills/mstack-angle-review/SKILL.md" \
  || fail "prefixed Claude install wrote wrong skill name"
grep -q '^name: product-context$' "$tmp_root/codex-noprefix/skills/product-context/SKILL.md" \
  || fail "unprefixed install wrote wrong skill name"
test -f "$tmp_root/codex-copy/skills/mstack-product-context/agents/openai.yaml" \
  || fail "copy install did not include agent metadata"
test -f "$tmp_root/codex/skills/mstack-learn/agents/openai.yaml" \
  || fail "learn skill was not installed with metadata"
test -f "$tmp_root/state/.last-setup-version" \
  || fail "setup did not write last setup version"
test -x "$tmp_root/codex/skills/mstack/bin/mstack-source-intake" \
  || fail "source-intake helper was not installed"
"$tmp_root/codex/skills/mstack/bin/mstack-source-intake" --self-test >/dev/null \
  || fail "installed source-intake helper failed self-test"
test -x "$tmp_root/codex/skills/mstack/bin/mstack-claim-check" \
  || fail "claim-check helper was not installed"
"$tmp_root/codex/skills/mstack/bin/mstack-claim-check" --self-test >/dev/null \
  || fail "installed claim-check helper failed self-test"
test -f "$tmp_root/codex-copy/skills/mstack/scripts/source_intake.py" \
  || fail "copy install did not include source-intake support script"
test -f "$tmp_root/codex-copy/skills/mstack/scripts/claim_check.py" \
  || fail "copy install did not include claim-check support script"

ok "temp installs"

bad_host_state="$tmp_root/bad-host-state"
if MSTACK_HOME="$bad_host_state" ./setup --host does-not-exist --quiet >/dev/null 2>&1; then
  fail "setup accepted unsupported host"
fi
test ! -e "$bad_host_state/.last-setup-version" \
  || fail "setup wrote migration version for unsupported host"

failing_root="$tmp_root/failing-migration-repo"
cp -R "$ROOT" "$failing_root"
rm -rf "$failing_root/.git" "$failing_root/.agents" "$failing_root/.claude" "$failing_root/scripts/__pycache__"
cat > "$failing_root/mstack-upgrade/migrations/v0.1.0.sh" <<'SH'
#!/usr/bin/env bash
exit 42
SH
chmod +x "$failing_root/mstack-upgrade/migrations/v0.1.0.sh"
if MSTACK_HOME="$tmp_root/failing-state" CODEX_HOME="$tmp_root/failing-codex" "$failing_root/setup" --host codex --quiet >/dev/null 2>&1; then
  fail "setup succeeded after failing migration"
fi
test ! -e "$tmp_root/failing-state/.last-setup-version" \
  || fail "setup wrote migration version after failing migration"

team_project="$tmp_root/team-project"
mkdir -p "$team_project"
bin/mstack-team-init optional --project "$team_project" --host codex --force >/dev/null
python3 - "$SKILLS_FILE" "$team_project/AGENTS.md" <<'PY'
import json
import sys
from pathlib import Path

config = json.loads(Path(sys.argv[1]).read_text())
text = Path(sys.argv[2]).read_text()
for skill in config["skills"]:
    route = config.get("routing", {}).get(skill, skill)
    expected = f"{route} -> `/mstack-{skill}`"
    if expected not in text:
        raise SystemExit(f"missing generated team route: {expected}")
PY
ok "migration and team-init regressions"

python3 scripts/messaging_eval.py --min-score 70
ok "messaging evals"

echo "mStack checks passed"
