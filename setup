#!/usr/bin/env bash
set -euo pipefail

umask 077

HOST=""
PREFIX="__host_default__"
FORCE="false"
COPY_MODE="false"
QUIET="false"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
HOSTS_FILE="$ROOT/config/hosts.json"
SKILLS_FILE="$ROOT/config/skills.json"
STATE_DIR="${MSTACK_HOME:-${MSTACK_STATE_DIR:-$HOME/.mstack}}"

usage() {
  cat <<'EOF'
Usage: ./setup [--host codex|claude|all] [--no-prefix] [--copy] [--force] [--quiet]

Installs mStack skills into configured host skill directories.

By default, setup creates lightweight runtime directories with host-safe skill
names and symlinked support files. Use --copy for a standalone install. Skills
are installed as mstack-* unless --no-prefix is passed.
EOF
}

log() {
  [ "$QUIET" = "true" ] || echo "$@"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --host)
      HOST="${2:-}"
      shift 2
      ;;
    --no-prefix)
      PREFIX=""
      shift
      ;;
    --copy)
      COPY_MODE="true"
      shift
      ;;
    --force)
      FORCE="true"
      shift
      ;;
    --quiet)
      QUIET="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

detect_hosts() {
  python3 - "$HOSTS_FILE" <<'PY'
import json
import os
import sys
from pathlib import Path

config = json.loads(Path(sys.argv[1]).read_text())
found = []
for name, host in config["hosts"].items():
    home = Path(os.path.expanduser(os.environ.get(host["homeEnv"], host["defaultHome"])))
    if home.exists():
        found.append(name)
print("\n".join(found or ["codex"]))
PY
}

list_hosts() {
  python3 - "$HOSTS_FILE" <<'PY'
import json
import sys
from pathlib import Path

print("\n".join(json.loads(Path(sys.argv[1]).read_text())["hosts"].keys()))
PY
}

list_skills() {
  python3 - "$SKILLS_FILE" <<'PY'
import json
import sys
from pathlib import Path

print("\n".join(json.loads(Path(sys.argv[1]).read_text())["skills"]))
PY
}

host_dest() {
  python3 - "$HOSTS_FILE" "$1" <<'PY'
import json
import os
import sys
from pathlib import Path

config = json.loads(Path(sys.argv[1]).read_text())
requested = sys.argv[2]
for name, host in config["hosts"].items():
    if requested == name or requested in host.get("aliases", []):
        home = os.environ.get(host["homeEnv"], host["defaultHome"])
        print(str(Path(os.path.expanduser(home)) / host["skillDir"]))
        break
else:
    raise SystemExit(f"Unsupported host: {requested}")
PY
}

host_prefix() {
  if [ "$PREFIX" != "__host_default__" ]; then
    printf '%s\n' "$PREFIX"
    return
  fi

  python3 - "$HOSTS_FILE" "$1" <<'PY'
import json
import sys
from pathlib import Path

config = json.loads(Path(sys.argv[1]).read_text())
requested = sys.argv[2]
for name, host in config["hosts"].items():
    if requested == name or requested in host.get("aliases", []):
        print(host.get("defaultPrefix", "mstack"))
        break
else:
    raise SystemExit(f"Unsupported host: {requested}")
PY
}

remove_target() {
  local target="$1"

  if [ "$FORCE" != "true" ]; then
    return 1
  fi

  rm -rf "$target"
}

target_points_to() {
  local target="$1"
  local expected="$2"

  if [ -L "$target" ]; then
    [ "$(cd "$(dirname "$(readlink "$target")")" 2>/dev/null && pwd -P)/$(basename "$(readlink "$target")")" = "$expected" ]
    return
  fi

  [ -d "$target" ] && [ "$(cd "$target" 2>/dev/null && pwd -P)" = "$expected" ]
}

copy_skill_dir() {
  local src="$1"
  local target="$2"
  local install_name="$3"
  local host="$4"
  local base="$5"

  mkdir -p "$target"
  cp -R "$src"/. "$target"/
  python3 "$ROOT/scripts/host_config.py" render --host "$host" --skill "$base" --name "$install_name" > "$target/SKILL.md.tmp"
  mv "$target/SKILL.md.tmp" "$target/SKILL.md"
}

install_support_dir() {
  local name="$1"
  local target="$2"
  local src="$ROOT/$name"
  local dest="$target/$name"

  [ -d "$src" ] || return 0
  rm -rf "$dest"

  if [ "$COPY_MODE" = "true" ]; then
    cp -R "$src" "$dest"
  else
    ln -s "$src" "$dest"
  fi
}

create_runtime_skill_dir() {
  local src="$1"
  local target="$2"
  local install_name="$3"
  local host="$4"
  local base="$5"

  mkdir -p "$target"
  python3 "$ROOT/scripts/host_config.py" render --host "$host" --skill "$base" --name "$install_name" > "$target/SKILL.md"

  if [ -d "$src/agents" ]; then
    rm -rf "$target/agents"
    ln -s "$src/agents" "$target/agents"
  fi
}

install_root_skill() {
  local host="$1"
  local dest="$2"
  local target="$dest/mstack"
  local tmp_file="$target/SKILL.md.tmp"

  if target_points_to "$target" "$ROOT"; then
    log "OK mstack already points at this checkout"
    return
  fi

  if [ -e "$target" ] || [ -L "$target" ]; then
    if ! remove_target "$target"; then
      log "SKIP mstack already exists. Re-run with --force to replace."
      return
    fi
  fi

  mkdir -p "$target"

  python3 "$ROOT/scripts/host_config.py" render --host "$host" --skill mstack --name mstack > "$tmp_file"
  mv "$tmp_file" "$target/SKILL.md"
  install_support_dir bin "$target"
  install_support_dir scripts "$target"

  log "INSTALLED mstack -> $target"
}

install_skill() {
  local host="$1"
  local dest="$2"
  local base="$3"
  local src="$ROOT/$base"
  local install_name="$base"
  local install_prefix

  install_prefix="$(host_prefix "$host")"

  if [ -n "$install_prefix" ]; then
    install_name="$install_prefix-$base"
  fi

  local target="$dest/$install_name"

  if [ -e "$target" ] || [ -L "$target" ]; then
    if ! remove_target "$target"; then
      log "SKIP $install_name already exists. Re-run with --force to replace."
      return
    fi
  fi

  if [ "$COPY_MODE" = "true" ]; then
    copy_skill_dir "$src" "$target" "$install_name" "$host" "$base"
  else
    create_runtime_skill_dir "$src" "$target" "$install_name" "$host" "$base"
  fi

  log "INSTALLED $install_name -> $target"
}

install_host() {
  local host="$1"
  local dest
  local start_prefix

  dest="$(host_dest "$host")"
  start_prefix="$(host_prefix "$host")"
  mkdir -p "$dest"

  install_root_skill "$host" "$dest"

  while IFS= read -r skill; do
    install_skill "$host" "$dest" "$skill"
  done < <(list_skills)

  log
  log "mStack ready for $host in $dest"
  log "Start with /${start_prefix:+$start_prefix-}product-context"
}

version_between() {
  python3 - "$1" "$2" "$3" <<'PY'
import sys

last, migration, current = sys.argv[1:4]

def parse(version: str) -> tuple[int, ...]:
    return tuple(int(part) for part in version.split(".") if part.isdigit())

last_v = parse(last) if last else tuple()
migration_v = parse(migration)
current_v = parse(current)
raise SystemExit(0 if last_v < migration_v <= current_v else 1)
PY
}

run_migrations() {
  local current_version
  local last_version
  local migration
  local migration_version

  current_version="$(tr -d '[:space:]' < "$ROOT/VERSION" 2>/dev/null || true)"
  [ -n "$current_version" ] || return 0

  mkdir -p "$STATE_DIR"
  if [ -f "$STATE_DIR/.last-setup-version" ]; then
    last_version="$(tr -d '[:space:]' < "$STATE_DIR/.last-setup-version")"
  else
    last_version=""
  fi

  for migration in "$ROOT"/mstack-upgrade/migrations/v*.sh; do
    [ -f "$migration" ] || continue
    migration_version="$(basename "$migration" .sh)"
    migration_version="${migration_version#v}"
    if version_between "$last_version" "$migration_version" "$current_version"; then
      log "MIGRATION v$migration_version"
      bash "$migration"
    fi
  done
}

record_setup_version() {
  local current_version

  current_version="$(tr -d '[:space:]' < "$ROOT/VERSION" 2>/dev/null || true)"
  [ -n "$current_version" ] || return 0
  mkdir -p "$STATE_DIR"
  echo "$current_version" > "$STATE_DIR/.last-setup-version"
}

validate_install_plan() {
  if [ -z "$HOST" ]; then
    detect_hosts >/dev/null
  elif [ "$HOST" = "all" ]; then
    list_hosts >/dev/null
  else
    host_dest "$HOST" >/dev/null
    host_prefix "$HOST" >/dev/null
  fi
}

validate_install_plan
run_migrations

if [ -z "$HOST" ]; then
  while IFS= read -r detected_host; do
    install_host "$detected_host"
  done < <(detect_hosts)
elif [ "$HOST" = "all" ]; then
  while IFS= read -r configured_host; do
    install_host "$configured_host"
  done < <(list_hosts)
else
  install_host "$HOST"
fi

record_setup_version
